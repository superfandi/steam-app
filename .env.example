# Salin file ini menjadi `.env` lalu isi dengan kredensial project Supabase Anda.
# Sumber nilai: Supabase Dashboard → Project Settings → API
#
# PENTING:
#   * Gunakan Publishable/anon key (aman untuk frontend, dilindungi RLS).
#   * JANGAN PERNAH menaruh service_role key (sb_secret_...) di file ini —
#     key tersebut melewati Row Level Security dan hanya boleh di server.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable-anon-key>
