# Salin file ini menjadi ".env" lalu isi dengan kredensial asli.
# Ambil dari: Supabase Dashboard -> Project Settings -> API
#
# Catatan keamanan: hanya SUPABASE_URL dan ANON_KEY yang boleh dipakai di
# frontend. JANGAN PERNAH menaruh SUPABASE_SERVICE_ROLE_KEY di file .env
# frontend karena melewati seluruh Row Level Security.

# URL project Supabase, contoh: https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Anon/public key (aman untuk frontend karena dilindungi RLS)
VITE_SUPABASE_ANON_KEY=
